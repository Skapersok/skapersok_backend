# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE/editor directories
.vscode/
.idea/

# Installer files
installer/

# Python packaging/build
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# User data and runtime files
